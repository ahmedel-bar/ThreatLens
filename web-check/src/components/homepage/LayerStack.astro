---
type Tone = 'good' | 'bad';

interface Layer {
  name: string;
  wireframe?: boolean;
  rows?: [string, string, Tone?][];
  ports?: [number, Tone?][];
}

// The layers of a site, top to bottom, with example findings on each
const layers: Layer[] = [
  { name: 'Page', wireframe: true },
  {
    name: 'Scripts',
    rows: [
      ['app.js', 'first party'],
      ['gtm.js', 'ad tracker', 'bad'],
      ['fbevents.js', 'social tracker', 'bad'],
      ['hotjar.js', 'analytics'],
      ['fonts.gstatic', 'cdn'],
    ],
  },
  {
    name: 'HTTP',
    rows: [
      ['status', '200 OK'],
      ['hsts', 'max-age=63072000', 'good'],
      ['csp', "default-src 'self'", 'good'],
      ['x-powered-by', 'Express', 'bad'],
      ['set-cookie', 'no SameSite', 'bad'],
    ],
  },
  {
    name: 'TLS',
    rows: [
      ['protocol', 'TLS 1.3', 'good'],
      ['cipher', 'AES_256_GCM'],
      ['issuer', "Let's Encrypt R11"],
      ['chain', 'R11 → ISRG X1'],
      ['expires', 'in 61 days', 'good'],
    ],
  },
  {
    name: 'Network',
    rows: [
      ['ip', '93.184.215.14'],
      ['asn', 'AS15133 Edgecast'],
      ['location', 'Ashburn, US'],
    ],
    ports: [[21], [22, 'bad'], [80, 'good'], [443, 'good'], [3306], [8080]],
  },
  {
    name: 'DNS',
    rows: [
      ['A', '93.184.215.14'],
      ['AAAA', '2606:2800:21f::'],
      ['MX', 'mx1.example.com'],
      ['TXT', 'v=spf1 -all'],
      ['DNSSEC', 'signed', 'good'],
    ],
  },
];
---

<div class="layer-stack" aria-hidden="true">
  <div class="stack" style={`--count: ${layers.length}`}>
    {
      layers.map((layer, index) => (
        <div class="layer" style={`--i: ${index}`}>
          <h4>{layer.name}</h4>
          {layer.wireframe && (
            <svg class="wireframe" viewBox="0 0 100 64">
              <rect width="100" height="7" />
              <rect class="title" y="13" width="66" height="9" />
              <rect class="button" y="27" width="28" height="6" />
              <rect y="40" width="30" height="24" />
              <rect x="35" y="40" width="30" height="24" />
              <rect x="70" y="40" width="30" height="24" />
            </svg>
          )}
          {layer.rows?.map(([key, value, tone]) => (
            <p>
              <span>{key}</span>
              <em class={tone}>{value}</em>
            </p>
          ))}
          {layer.ports && (
            <div class="ports">
              {layer.ports.map(([port, tone]) => (
                <span class={tone}>{port}</span>
              ))}
            </div>
          )}
        </div>
      ))
    }
    <div class="scan"></div>
  </div>
</div>

<style lang="scss">
  @use '@styles/global.scss' as *;

  @property --gap {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  .layer-stack {
    position: relative;
    width: 33vw;
    height: 95vh;
    container-type: size;
    z-index: 2;
    @include desktop-down {
      display: none;
    }
  }

  // Isometric view of the layers, spaced by --gap and shifted down to sit centred
  .stack {
    --size: min(56cqw, 44cqh);
    --gap: min(12cqh, calc(var(--size) * 0.45));
    --cycle: 6s;
    position: absolute;
    inset: 0;
    margin: auto;
    width: var(--size);
    height: var(--size);
    transform-style: preserve-3d;
    transform: translateY(calc((var(--count) - 1) * var(--gap) * 0.43)) rotateX(60deg)
      rotateZ(-45deg);
    animation: stack-breathe var(--cycle) ease-in-out infinite alternate;
    font-family: var(--font-mono);
    font-size: calc(var(--size) * 0.04);
  }

  // Layer i (from the top) lifts and lights up as the scan plane passes through it
  .layer {
    --edge: color-mix(in srgb, var(--primary) 35%, transparent);
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 4%;
    padding: 7%;
    transform: translateZ(calc((var(--count) - 1 - var(--i)) * var(--gap)));
    background: color-mix(in srgb, var(--background-raised) 93%, transparent);
    border: 1px solid var(--edge);
    color: var(--text-color-secondary);
    animation: stack-inspect var(--cycle) ease-in-out infinite;
    animation-delay: calc(((var(--i) + 0.5) / var(--count) * 0.75 - 0.1) * var(--cycle));
  }

  h4 {
    font-size: 1.4em;
    font-weight: normal;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--primary);
  }

  p {
    display: flex;
    justify-content: space-between;
    gap: 1em;
    padding-bottom: 1.5%;
    border-bottom: 1px solid color-mix(in srgb, var(--text-color) 10%, transparent);
    white-space: nowrap;
  }

  em {
    font-style: normal;
    color: var(--text-color);
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .good {
    color: var(--primary);
  }

  .bad {
    color: var(--danger);
  }

  .wireframe {
    flex: 1;
    rect {
      fill: color-mix(in srgb, var(--text-color) 14%, transparent);
    }
    .title {
      fill: color-mix(in srgb, var(--text-color) 30%, transparent);
    }
    .button {
      fill: var(--primary);
    }
  }

  .ports {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 3%;
    span {
      display: grid;
      place-items: center;
      aspect-ratio: 1;
      font-size: 0.85em;
      border: 1px solid color-mix(in srgb, currentColor 40%, transparent);
    }
    .good,
    .bad {
      border-color: currentColor;
      background: color-mix(in srgb, currentColor 20%, transparent);
    }
  }

  // Sweeps from the top layer to the bottom, then fades and starts again
  .scan {
    position: absolute;
    inset: -8%;
    border: 1px solid var(--primary);
    background: color-mix(in srgb, var(--primary) 10%, transparent);
    box-shadow: 0 0 3rem color-mix(in srgb, var(--primary) 40%, transparent);
    animation: stack-scan var(--cycle) linear infinite;
  }

  @keyframes stack-breathe {
    from {
      --gap: min(11cqh, calc(var(--size) * 0.4));
    }
    to {
      --gap: min(13.5cqh, calc(var(--size) * 0.5));
    }
  }

  @keyframes stack-scan {
    0% {
      transform: translateZ(calc((var(--count) - 0.5) * var(--gap)));
      opacity: 0;
    }
    8%,
    70% {
      opacity: 1;
    }
    75%,
    100% {
      transform: translateZ(calc(var(--gap) * -0.5));
      opacity: 0;
    }
  }

  // Rises to meet the scan plane, peaking at 10% as it passes, then settles back
  @keyframes stack-inspect {
    0%,
    30%,
    100% {
      translate: 0 0 0;
      border-color: var(--edge);
      box-shadow: none;
    }
    10% {
      translate: 0 0 2.5cqh;
      border-color: var(--primary);
      box-shadow: 0 0 3rem color-mix(in srgb, var(--primary) 35%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stack,
    .layer {
      animation: none;
    }
    .scan {
      display: none;
    }
  }
</style>
