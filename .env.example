# ============================================================
# ThreatLens - Environment Configuration
# ============================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Provider Execution Mode: 'live' (default, queries real provider APIs) or 'mock' (tests only)
PROVIDER_MODE=live

# Database Connection (PostgreSQL for prod/docker, SQLite supported for quick local dev)
DATABASE_URL=sqlite+aiosqlite:///./threatlens.db
# For PostgreSQL: postgresql+asyncpg://threatlens:threatlens_secure_pwd@localhost:5432/threatlens

# Pivot Engine Safety Constraints
MAX_PIVOT_DEPTH=2
MAX_PIVOT_NODES=25
MAX_PROVIDER_REQUESTS=40

# Cache TTL in seconds (e.g., 3600 = 1 hour)
CACHE_TTL=3600

# ============================================================
# Threat Intelligence Provider API Keys (Backend Only)
# ============================================================

# 1. VirusTotal API v3 (https://virustotal.com)
VT_API_KEY=

# 2. AlienVault OTX (https://otx.alienvault.com)
OTX_API_KEY=

# 3. MalwareBazaar / Abuse.ch (https://bazaar.abuse.ch)
MALWAREBAZAAR_API_KEY=

# 4. Hybrid Analysis / Falcon Sandbox (https://www.hybrid-analysis.com)
HYBRID_ANALYSIS_API_KEY=

# 5. Pulsedive (https://pulsedive.com)
PULSEDIVE_API_KEY=

# 6. AbuseIPDB (https://abuseipdb.com)
ABUSEIPDB_API_KEY=

# 7. ThreatFox / Abuse.ch (https://threatfox.abuse.ch)
THREATFOX_API_KEY=

# 8. URLhaus / Abuse.ch (https://urlhaus.abuse.ch)
URLHAUS_API_KEY=

# 9. urlscan.io (https://urlscan.io)
URLSCAN_API_KEY=

# 10. Censys Platform API v3 (https://docs.censys.com)
# Personal Access Token (PAT) from Censys Platform User Settings -> API Access
CENSYS_API_KEY=
# Note: CENSYS_API_SECRET is also supported as a backward-compatible alias.

# 11. GreyNoise API v3 (https://greynoise.io)
GREYNOISE_API_KEY=

# 12. Shodan (https://shodan.io)
SHODAN_API_KEY=

# 13. Criminal IP (https://www.criminalip.io)
CRIMINALIP_API_KEY=
